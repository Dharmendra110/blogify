<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
    <title>Homepage</title>
  </head>
  <body>
    <%- include('./partials/navbar.ejs') %> 
    <div class=" container mt-3 grid grid-cols-3  ">
      <% blogs.forEach(blog => { %>
         <section class="card" style="max-width: 320px">
        <img src="<%= blog.coverImageURL %>" class="card-img-top"  />
        <div class="card-body">
          <h4 class="card-title"><%= blog.title  %></h4>
         
          <a href="/blog/<%= blog._id %>" class="btn-solid theme-primary">View</a>
        </div>
      </section>
      <% }) %>
    
    </div>
    <%- include('./partials/script.ejs') %>
  </body>
</html>
