<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
    <title>Blog</title>
  </head>
  <body>
    <%- include('./partials/navbar.ejs') %>

    <div class="container mt-4">
      <h1><%=blog.title %></h1>
      <img src="<%=blog.coverImageURL  %>" alt="" />
      <pre class="mt-3"><%= blog.body %></pre>
    </div>

    <div class="container mt-4">
      <img src="<%=blog.createdBy.profileImageURL  %>" alt="" width="50px"> <%= blog.createdBy.fullName  %>
    </div>

   <% if (locals.user) { %>
      <div class="container mt-4">
      <h1>Comments (<%=comments.length  %>) </h1>
       <form action="/blog/comment/<%=blog._id  %>" method="POST">
        <div class="mb-3">
         
          <input
            type="text"
            name="content"
            class="form-control"
            placeholder="Enter your comment"
          />
          <button class="btn-solid theme-primary" type="submit">Add</button>
        </div>
     </form>

    
    </div>
    
   <% } %>
    <div class=" container mt-4">
      <% comments.forEach(comment => { %>
       <img src="<%=comment.createdBy.profileImageURL  %> " width="50px">
       <%= comment.createdBy.fullName  %>: <pre><%= comment.content %></pre>
      <% }) %>
     </div>

    <%- include('./partials/script.ejs') %>
  </body>
</html>
